{
  "version": 2,
  "notes": "DRAFT. Cents are 24-TET approximations. Regional tuning differs (Arab, Turkish, Persian). Every entry needs review by a player/teacher before release.",
  "conventions": {
    "degrees": "1-based. Degree 1 is the tonic.",
    "cents": "Maqam cents are measured from the maqam's tonic. Jins cents are measured from the jins root.",
    "ajnas": "Each maqam lists {jins, root_degree}. The core library derives absolute cents from the ajnas library. Ajnas may overlap (an upper jins can start on the last note of the lower one).",
    "changes": "Keys are 1-based degree numbers as strings. Values are cents that replace the ascending value for that degree.",
    "variants": "An ascending variant applies its 'changes' to the ascending scale. If it has an 'ajnas' list, that list replaces the maqam's ajnas.",
    "descending": "null means not yet specified: the UI must not show a descending form. Otherwise {changes, ajnas} as for variants.",
    "octave_repeating": "false means the scale does not repeat at 1200 cents (for example Saba). The ascending list then gives the notes in the first register.",
    "quarter_tones": "Not stored. Whether a note is off the 12-TET grid depends on the selected tonic, so the core library computes it: (tonic_cents + degree_cents) mod 100 != 0.",
    "reference_tonic": "The traditional tonic, for display and as an optional transposition. cents_above_c is in 0-1199. The default playing tonic is F, chosen by the user."
  },
